local gunNames = {
	"Slingshot","Refined Slingshot","Flintlock","Musket","Cannon","Bazooka","Acidum Rifle",
	"Kabucha","Serpent Bow","Soul Guitar","Venom Bow","Bizarre Rifle","Skull Guitar"
}
local fruitNames = {
	"Rocket","Spin","Chop","Spring","Bomb","Smoke","Spike","Flame","Ice","Sand","Dark","Diamond",
	"Light","Rubber","Barrier","Ghost","Magma","Quake","Buddha","Love","Spider","Sound","Phoenix",
	"Portal","Rumble","Pain","Blizzard","Gravity","Mammoth","T-Rex","Dough","Shadow","Venom","Control",
	"Gas","Spirit","Dragon","Leopard","Kitsune"
}

local function getToolType(tool)
	if not tool:IsA("Tool") then return nil end
	local name = tool.Name
	local tooltip = tool:FindFirstChild("ToolTip") and tool.ToolTip.Value or ""

	if tooltip == "Melee" or name:find("Combat") or name:find("Dark Step") or name:find("Electric") or name:find("Water") or name:find("Dragon") or name:find("Godhuman") or name:find("Sanguine") then
		return "Melee", name
	end

	for _, g in ipairs(gunNames) do
		if name == g or name:find(g) then return "Gun", name end
	end
	if tooltip == "Gun" or name:find("Bow") or name:find("Gun") or name:find("Rifle") or name:find("Cannon") or name:find("Slingshot") or name:find("Flintlock") or name:find("Musket") or name:find("Bazooka") or name:find("Guitar") then
		return "Gun", name
	end

	for _, f in ipairs(fruitNames) do
		if (name == f or name:find(f)) and not name:find("Bow") then
			return "Fruit", name
		end 
	end
	if tooltip == "Blox Fruit" then return "Fruit", name end

	if tooltip == "Sword" or name:find("Katana") or name:find("Sword") or name:find("Saber") or name:find("Yoru") or name:find("Dagger") or name:find("Dark Blade") or name:find("Triple Katana") or name:find("Blade") then
		return "Sword", name
	end

	return nil
end

local function updateEquipment()
	local itemsFound = {Melee="Ninguno", Fruit="Ninguno", Sword="Ninguna", Gun="Ninguna"}
	local function process(container)
		if not container then return end
		for _, tool in pairs(container:GetChildren()) do
			local cat, n = getToolType(tool)
			if cat then itemsFound[cat] = n end
		end
	end
	process(player:FindFirstChild("Backpack"))
	process(player.Character)
	
	categoryLabels[1].Text = "1- Melee: " .. itemsFound.Melee
	categoryLabels[2].Text = "2- Fruta: " .. itemsFound.Fruit
	categoryLabels[3].Text = "3- Espada: " .. itemsFound.Sword
	categoryLabels[4].Text = "4- Pistola: " .. itemsFound.Gun
	
	teamLabel.Text = "Team: " .. (player.Team and player.Team.Name or "Ninguno")
	
	local bounty = 0
	pcall(function()
		if player:FindFirstChild("leaderstats") then
			local b = player.leaderstats:FindFirstChild("Bounty/Honor") or player.leaderstats:FindFirstChild("Bounty")
			if b then bounty = b.Value end
		end
	end)

	if not initialBounty and bounty > 0 then
		initialBounty = bounty
	end

	local earned = initialBounty and (bounty - initialBounty) or 0
	local earnedSign = earned >= 0 and "+$" or "-$"

	bountyLabel.Text = "Bounty/Honor: " .. formatBounty(bounty)
	earnedBountyLabel.Text = "Bounty Ganado: " .. earnedSign .. formatBounty(math.abs(earned)):sub(2)
end

task.spawn(function()
	while task.wait(2) do updateEquipment() end
end)

