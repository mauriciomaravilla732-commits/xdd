fastFlagBtn.MouseButton1Click:Connect(function()
	_G.FastFlagActive = not _G.FastFlagActive

	if _G.FastFlagActive then
		fastFlagBtn.Text = "🚩 Fast Flag: ON"
		fastFlagBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 80)
		updateExecuteCount(1)

		pcall(function()
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 9e9
			Lighting.Brightness = 0
			Lighting.Technology = Enum.Technology.Compatibility

			for _, v in pairs(Lighting:GetChildren()) do
				if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") or v:IsA("Clouds") then
					v:Destroy()
				end
			end

			local function applyOptimizations(obj)
				if obj:IsA("BasePart") then
					obj.Material = Enum.Material.SmoothPlastic
					obj.Reflectance = 0
					obj.CastShadow = false
				elseif obj:IsA("Decal") or obj:IsA("Texture") then
					obj:Destroy()
				elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
					obj.Enabled = false
				end
			end

			for _, desc in pairs(workspace:GetDescendants()) do
				applyOptimizations(desc)
			end

			workspace.DescendantAdded:Connect(function(desc)
				if _G.FastFlagActive then
					applyOptimizations(desc)
				end
			end)
		end)
	else
		fastFlagBtn.Text = "🚩 Fast Flag: OFF"
		fastFlagBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
		updateExecuteCount(-1)
	end
end)

